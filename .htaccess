Options -Indexes
DirectoryIndex disabled

# Páginas de erro próprias (não herda as de um site na pasta acima)
ErrorDocument 403 default
ErrorDocument 404 default
ErrorDocument 500 default

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pastas internas nunca são servidas
    RewriteRule ^(frontend|app|database|storage|node_modules|\.git)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Painel (SPA)
    RewriteRule ^$ public/index.html [END]
    RewriteRule ^index\.html$ public/index.html [END]

    # Download do app da TV (endereço curto para digitar no aparelho)
    RewriteRule ^app/?$ api/index.php?_route=player/app/download [END]

    # Player da TV
    RewriteRule ^tv/?$ public/tv.html [END]
    RewriteRule ^tv/(assets/.+)$ public/$1 [END]

    # Arquivos estáticos do build
    RewriteRule ^(assets/.+|favicon\.svg|icon-.+\.png|manifest\.webmanifest)$ public/$1 [END]
</IfModule>
