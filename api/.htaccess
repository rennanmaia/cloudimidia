Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Repassa o cabeçalho Authorization para o PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Todas as requisições passam pelo index.php (inclusive tentativas de acessar lib/, controllers/, config.php)
    RewriteRule ^(.*)$ index.php?_route=$1 [QSA,END]
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 120
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 120
</IfModule>
